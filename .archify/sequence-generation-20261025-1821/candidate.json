  "cards": [
    {
      "dot": "emerald",
      "title": "为什么分成四步",
      "items": [
        "大纲先流式返回，学生能立刻看到课程骨架",
        "角色决定讲稿口吻，必须在逐场景内容之前确定",
        "动作与讲稿单独生成，方便只重做某一场景的配音"
      ]
    },
    {
      "dot": "amber",
      "title": "耗时与并行",
      "items": [
        "单场景内容实测 60–82 秒，是整条链路的主要耗时",
        "四路并发后，四个场景的总墙钟从 317 秒降到 83 秒",
        "函数超时上限 120 秒，单请求不再被截断"
      ]
    },
    {
      "dot": "rose",
      "title": "失败与降级",
      "items": [
        "大纲流中途断开时保留已解析的场景，不整批重来",
        "模型返回非法 JSON 时走修复与重试，仍失败才报错",
        "生成结果落到 localStorage，刷新不丢"
      ]
    }
  ]
